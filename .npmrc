# =============================================================================
# Configuração npm do projeto
# -----------------------------------------------------------------------------
# O npm já isola dependências do projeto em ./node_modules por padrão (design
# nativo do npm). Esta configuração garante apenas que o CACHE também fique
# contido no projeto, sem escrever em ~/.npm.
# =============================================================================

# Cache do npm dentro do projeto
cache=./.npm

# Não baixar fundos de aviso
fund=false

---
import "../../styles/article.css";

import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { giscus } from "spectre:globals";
import Card from "../../components/Card.astro";
import ImageGlow from "../../components/ImageGlow.astro";
import Layout from "../../layouts/Layout.astro";
import { getPostBySlug, urlFor } from "../../lib/sanity";

// Desativar prerender para permitir SSR
export const prerender = false;

/**
 * Estimates the time it takes to read a post in minutes
 */
function timeToRead(content: string): number {
	const numWords = (content || "")
		.replace(/.*\[(.*?)\].*/gm, "$1")
		.replace(/```.*?```/gms, "")
		.split(/\s+/).length;

	const numImages = content?.match(/!\[/g)?.length || 0;
	const numCodeblocks = content?.match(/```/g)?.length || 0;

	return (
		Math.ceil(numWords / 200) +
		Math.ceil(numImages / 6) +
		Math.ceil(numCodeblocks / 3)
	);
}

// Buscar o slug da URL
const { post: postSlug } = Astro.params;

// Preparar variáveis
let title: string = "";
let description: string = "";
let createdAt: Date = new Date();
let updatedAt: Date | undefined;
let tags: string[] = [];
let imageUrl: string | undefined;
let Content: any;
let headings: any[] = [];
let bodyContent: string = "";
let isLocalPost = false;
let localPostData: CollectionEntry<"posts"> | null = null;
let found = false;

// Primeiro, tentar buscar post local
const localPosts = await getCollection(
	"posts",
	(post) => post.data.draft !== true,
);
const matchedLocalPost = localPosts.find((p) => p.id === postSlug);

if (matchedLocalPost) {
	found = true;
	isLocalPost = true;
	localPostData = matchedLocalPost;
	title = matchedLocalPost.data.title;
	description = matchedLocalPost.data.description;
	createdAt = matchedLocalPost.data.createdAt;
	updatedAt = matchedLocalPost.data.updatedAt;
	tags = matchedLocalPost.data.tags.map((tag) => tag.id);
	bodyContent = matchedLocalPost.body || "";

	const rendered = await render(matchedLocalPost);
	Content = rendered.Content;
	headings = rendered.headings;
} else {
	// Tentar buscar post do Sanity
	const sanityPost = await getPostBySlug(postSlug!);

	if (sanityPost) {
		found = true;
		title = sanityPost.title;
		description = sanityPost.excerpt || "";
		createdAt = new Date(sanityPost.date);
		updatedAt = undefined;
		tags = sanityPost.tags?.map((tag: any) => tag.name) || [];
		imageUrl = sanityPost.coverImage
			? urlFor(sanityPost.coverImage).width(1200).url()
			: undefined;
		bodyContent = sanityPost.content || "";
	}
}

// Se não encontrou em nenhum lugar, retornar 404
if (!found) {
	return Astro.redirect("/404");
}

const readingTime = timeToRead(bodyContent);
---

<Layout
	title={title}
	description={description}
	article={{
		createdAt: createdAt,
		updatedAt: updatedAt,
	}}
>
	<div class="left" slot="left">
		<Card class="toc-card">
			<h2 class="no-mt">Índice</h2>
			<ol>
				<li class="toc-li">
					<a href={"#_top"} class="active">{title}</a>
				</li>
				{
					headings.map((heading) => (
						<li class="toc-li" data-depth={heading.depth}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))
				}
			</ol>
		</Card>
	</div>
	<article slot="right" data-pagefind-body>
		<Card>
			<div class="article-header" id="_top" data-pagefind-ignore>
				{isLocalPost && localPostData ? (
					<ImageGlow
						quality={100}
						class="article-image"
						src={localPostData.data.image}
						alt={title}
					/>
				) : imageUrl ? (
					<img
						class="article-image sanity-image"
						src={imageUrl}
						alt={title}
					/>
				) : null}
				<div class="header">
					<div>
						<h1 class="no-mt article-h1">{title}</h1>
					</div>
					<div class="article-info">
						<span>{createdAt.toLocaleDateString()}</span>
						<span>/</span>
						<span>{readingTime} minuto{readingTime === 1 ? "" : "s"} de leitura</span>
						<span>/</span>
						<span>Categorias: {tags.join(", ")}</span>
					</div>
				</div>
			</div>
			{isLocalPost && Content ? (
				<Content />
			) : (
				<div class="sanity-content" set:html={bodyContent} />
			)}
			<hr class="end-of-article" />
			<a href="/blog" class="block-link" data-pagefind-ignore>← Voltar ao blog</a>
		</Card>
		{
			giscus && (
				<Card>
					<div class="comments" data-pagefind-ignore>
						<script
							is:inline
							src="https://giscus.app/client.js"
							data-repo={giscus.repository}
							data-repo-id={giscus.repositoryId}
							data-category={giscus.category}
							data-category-id={giscus.categoryId}
							data-mapping={giscus.mapping}
							data-strict={giscus.strict === true ? "1" : "0"}
							data-reactions-enabled={
								giscus.reactionsEnabled === true ? "1" : "0"
							}
							data-emit-metadata={giscus.emitMetadata === true ? "1" : "0"}
							data-input-position={giscus.commentsInput}
							data-theme={
								giscus.theme || "https://spectre.lou.gg/styles/giscus"
							}
							data-lang={giscus.lang}
							data-loading="lazy"
							crossorigin="anonymous"
							async
						/>
					</div>
				</Card>
			)
		}
	</article>
</Layout>
<script src="../../scripts/toc.ts"></script>
<style is:global>
	.toc-card ol {
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 0;
		list-style-type: none;
		position: relative;
	}

	.toc-card ol li a {
		color: #c7c7c7;
		font-size: 0.925rem;
		padding: 0.25rem 0.5rem;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	.toc-card ol li a:hover {
		color: white;
		text-decoration: none;
	}

	.toc-card ol li a.active {
		color: white;
		background: var(--primary);
	}

	.left {
		height: 100%;
		position: relative;
	}

	.toc-card {
		position: sticky;
		top: 2rem;
	}

	article {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.comments * {
		border-color: #353535 !important;
	}

	.sanity-image {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		margin-bottom: 1rem;
	}

	.sanity-content {
		line-height: 1.7;
	}

	.sanity-content h1,
	.sanity-content h2,
	.sanity-content h3,
	.sanity-content h4,
	.sanity-content h5,
	.sanity-content h6 {
		margin-top: 1.5em;
		margin-bottom: 0.5em;
	}

	.sanity-content p {
		margin-bottom: 1em;
	}

	.sanity-content pre {
		background: #1e1e1e;
		padding: 1rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		margin: 1em 0;
	}

	.sanity-content code {
		font-family: monospace;
		background: #2d2d2d;
		padding: 0.2em 0.4em;
		border-radius: 0.25rem;
	}

	.sanity-content pre code {
		background: none;
		padding: 0;
	}

	@media screen and (max-width: 640px) {
		article {
			gap: 1rem;
		}
	}
</style>

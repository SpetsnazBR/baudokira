# ══════════════════════════════════════════════════════════════════
# Configuração do CMS local (copia para .env e preencha se quiser)
# O arquivo .env é ignorado pelo git — nunca commitá-lo.
# ══════════════════════════════════════════════════════════════════

# Endereço/porta do servidor local (só aceita conexões locais)
CMS_HOST=127.0.0.1
CMS_PORT=4444

# Token opcional de acesso: se preenchido, o painel/API exigem
# este token (via formulário ou header "Authorization: Bearer <token>").
# Recomendado definir um valor aleatório, ex.:  openssl rand -hex 24
CMS_TOKEN=

# Se "1", o botão "Publicar no GitHub" também executa `git push`
# após o commit local. Requer que o git consiga autenticar sozinho.
# Se "0" (padrão), apenas faz o commit local — você faz o push manual.
CMS_AUTO_PUSH=0
